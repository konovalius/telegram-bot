# ── Telegram ──────────────────────────────────────────────────────────────
# Токен от @BotFather
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── LLM: выберите ОДИН блок и раскомментируйте его ────────────────────────

# Вариант 1. OpenRouter — десятки моделей одним ключом, есть :free тарифы
# Ключ: https://openrouter.ai/keys   Лимиты free: ~20 запросов/мин
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Вариант 2. Groq — самый быстрый инференс, 14 400 запросов/сутки
# Ключ: https://console.groq.com/keys
# LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Вариант 3. Google Gemini — OpenAI-совместимый эндпоинт
# Ключ: https://aistudio.google.com/apikey
# LLM_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# Вариант 4. Локально через Ollama — без ключей и лимитов вообще
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b

# ── Поведение ─────────────────────────────────────────────────────────────
SYSTEM_PROMPT=Ты полезный ассистент в Telegram. Отвечай кратко и по делу.
HISTORY_LIMIT=20
MAX_TOKENS=1200
TEMPERATURE=0.7
REQUEST_TIMEOUT=90
RATE_LIMIT_SECONDS=2

# ── Доступ ────────────────────────────────────────────────────────────────
# Пусто = бот отвечает всем. Через запятую = белый список разрешённых user id.
ALLOWED_USER_IDS=
# Кому доступна команда /stats. Свой id узнать: @userinfobot
ADMIN_IDS=
